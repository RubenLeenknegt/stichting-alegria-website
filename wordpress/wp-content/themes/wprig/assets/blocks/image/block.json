{
  "name": "wp-rig/img",
  "apiVersion": 2,
  "title": "Image",
  "category": "media",
  "icon": "format-image",
  "description": "A simple centered single image.",
  "textdomain": "wp-rig",
  "attributes": {
    "imageUrl": {
      "type": "string",
      "default": ""
    },
    "imageId": {
      "type": "number",
      "default": 0
    },
    "imageAlt": {
      "type": "string",
      "default": ""
    }
  },
  "supports": {
    "html": false
  },
  "render": "file:./render.php",
  "editorScript": "file:./build/index.js",
  "style": "file:./build/style.css",
  "editorStyle": "file:./build/editor.css"
}
