{
  "name": "wp-rig/scrolllint",
  "apiVersion": 2,
  "title": "Scrolllint",
  "category": "widgets",
  "icon": "images-alt2",
  "description": "A full-width strip of images that scrolls continuously left to right. Images are decorative and not clickable.",
  "textdomain": "wp-rig",
  "attributes": {
    "title": {
      "type": "string",
      "default": ""
    },
    "images": {
      "type": "array",
      "default": [],
      "items": { "type": "object" }
    }
  },
  "supports": {
    "html": false,
    "align": ["full"]
  },
  "render": "file:./render.php",
  "editorScript": "file:./build/index.js",
  "style": "file:./build/style.css",
  "editorStyle": "file:./build/editor.css"
}
