{
  "name": "wp-rig/txt",
  "apiVersion": 2,
  "title": "Text",
  "category": "text",
  "icon": "text",
  "description": "A centered text block with an optional title (H2 or H3).",
  "textdomain": "wp-rig",
  "attributes": {
    "title": {
      "type": "string",
      "default": ""
    },
    "titleTag": {
      "type": "string",
      "default": "h2"
    },
    "bodyText": {
      "type": "string",
      "default": ""
    }
  },
  "supports": {
    "html": false
  },
  "render": "file:./render.php",
  "editorScript": "file:./build/index.js",
  "style": "file:./build/style.css",
  "editorStyle": "file:./build/editor.css"
}
