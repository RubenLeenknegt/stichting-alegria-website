{
  "name": "wp-rig/upcoming-events",
  "apiVersion": 3,
  "title": "Aankomende evenementen",
  "category": "design",
  "icon": "calendar-alt",
  "description": "Toont de eerstvolgende evenementen in een slider. Zonder aankomende evenementen wordt het blok niet getoond.",
  "textdomain": "alegria",
  "attributes": {
    "title": {
      "type": "string",
      "default": ""
    },
    "maxEvents": {
      "type": "number",
      "default": 6
    }
  },
  "editorScript": "file:./build/index.js",
  "style": [ "alegria-swiper", "file:./build/style.css" ],
  "viewScript": "file:./build/view.js",
  "render": "file:./render.php",
  "supports": {
    "align": ["wide", "full"]
  }
}
