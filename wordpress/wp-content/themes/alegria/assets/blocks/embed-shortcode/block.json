{
  "name": "wp-rig/embed-shortcode",
  "apiVersion": 3,
  "title": "Shortcode / embed",
  "category": "widgets",
  "icon": "embed-generic",
  "description": "Voert een shortcode uit (bijv. een formulier) of sluit iframe-/HTML-code in.",
  "textdomain": "alegria",
  "attributes": {
    "content": {
      "type": "string",
      "default": ""
    },
    "isIframe": {
      "type": "boolean",
      "default": false
    }
  },
  "supports": {
    "html": false,
    "align": ["wide", "full"]
  },
  "render": "file:./render.php",
  "editorScript": "file:./build/index.js",
  "style": "file:./build/style.css"
}
