{
  "$schema": "https://schemas.wp.org/wp/6.9/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": false,
    "layout": {
      "contentSize": "800px",
      "wideSize": "1200px"
    },
    "color": {
      "custom": false,
      "customGradient": false,
      "customDuotone": false,
      "defaultPalette": false,
      "defaultGradients": false,
      "defaultDuotone": false,
      "palette": [
        { "slug": "primary", "color": "#1D9741", "name": "Groen" },
        { "slug": "primary-dark", "color": "#062E13", "name": "Donkergroen" },
        { "slug": "secondary", "color": "#E53935", "name": "Rood" },
        { "slug": "light-grey", "color": "#F8F9F7", "name": "Lichtgrijs" },
        { "slug": "black", "color": "#000000", "name": "Zwart" },
        { "slug": "white", "color": "#FFFFFF", "name": "Wit" }
      ]
    },
    "typography": {
      "customFontSize": false,
      "defaultFontSizes": false,
      "dropCap": false,
      "fontFamilies": [
        {
          "slug": "rubik",
          "name": "Rubik",
          "fontFamily": "Rubik, sans-serif",
          "fontFace": [
            {
              "fontFamily": "Rubik",
              "fontWeight": "300 900",
              "fontStyle": "normal",
              "fontDisplay": "swap",
              "src": [ "file:./assets/fonts/rubik-latin-wght-normal.woff2" ]
            }
          ]
        }
      ]
    },
    "spacing": {
      "defaultSpacingSizes": false
    }
  }
}
