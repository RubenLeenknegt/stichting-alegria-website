# WordPress: track only the custom theme.
# Everything under wordpress/ (core, wp-config, .htaccess, plugins, mu-plugins,
# uploads, languages, caches, backups, ...) is ignored, then the theme is
# re-included. Each level must be un-ignored before the next one can be.
/wordpress/*
!/wordpress/wp-content/
/wordpress/wp-content/*
!/wordpress/wp-content/themes/
/wordpress/wp-content/themes/*
!/wordpress/wp-content/themes/alegria/
# Theme build output and node_modules: see wordpress/wp-content/themes/alegria/.gitignore

# Environment files (contain credentials)
.env
.env.*
!env.example

# Docker volumes data
db_data/

# Node
node_modules/
package-lock.json
*.log

# IDE and OS files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
